            <span class="brand-text">
              <strong>SUTRA</strong>
              <em>LOUNGE</em>
            </span>
          </a>
          <p data-i18n="footer.tag"><%= s('restaurant.cuisine') %>. <%= s('restaurant.tagline') %>.</p>

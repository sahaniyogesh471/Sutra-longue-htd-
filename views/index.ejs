            <li><a href="#about" data-i18n="nav.about">About</a></li>
            <li><a href="#menu" data-i18n="nav.menu">Signature Dishes</a></li>
            <li><a href="#bestsellers" data-i18n="nav.best">Bestsellers</a></li>

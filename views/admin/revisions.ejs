<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head'); %>
</head>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar'); %>
  <main class="main">
    <%- include('partials/topbar'); %>

    <div class="card">
      <div class="card-head">
        <h3>Revision history</h3>
        <div class="btn-group">
          <button class="btn btn-ghost btn-small" type="button" data-action="undo">Undo</button>
          <button class="btn btn-ghost btn-small" type="button" data-action="redo">Redo</button>
        </div>
      </div>
      <p class="muted" style="margin:0 0 14px;">Every publish stores a full snapshot of the site. Undo / redo move the pointer and stay correct after page reloads. Restoring an older revision rolls the whole site back to that point in time.</p>

      <ul class="rev-list">
        <% revisions.forEach(function (r) { %>
          <li class="<%= r.current ? 'is-current' : '' %>" data-rev="<%= r.id %>">
            <div class="rev-marker">
              <span class="rev-dot"></span>
            </div>
            <div class="rev-body">
              <div class="rev-title">
                <strong>#<%= r.id %> · <%= r.action %></strong>
                <% if (r.current) { %><span class="pill pill-gold">Current</span><% } %>
                <span class="pill pill-ok"><%= r.kind %></span>
              </div>
              <div class="cell-sub"><%= r.created_at %><% if (r.created_by) { %> · by <%= r.created_by %><% } %></div>
            </div>
            <div class="rev-actions">
              <% if (!r.current) { %>
                <button class="btn btn-ghost btn-tiny" type="button" data-rev-restore="<%= r.id %>">Restore this revision</button>
              <% } %>
            </div>
          </li>
        <% }); %>
        <% if (revisions.length === 0) { %>
          <li class="empty">
            <h4>No revisions yet.</h4>
            <p class="muted">Publish a change and its full snapshot will be stored here for undo / redo.</p>
          </li>
        <% } %>
      </ul>
    </div>
  </main>
</div>
<%- include('partials/foot'); %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard · Sutra Lounge Admin</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/admin.css">
</head>
<body>
<div class="admin-shell">
  <aside class="sidebar">
    <div class="brand">
      <div class="mark">S</div>
      <div>
        <strong>SUTRA</strong>
        <em>ADMIN CONSOLE</em>
      </div>
    </div>
    <a class="nav-item active" href="/admin">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
      Dashboard
    </a>
    <a class="nav-item" href="/admin/settings">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.09a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.09a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      Site Settings
    </a>
    <a class="nav-item" href="/admin/dishes">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17h16M4 12h16M4 7h16"/><circle cx="12" cy="17" r="3"/><circle cx="12" cy="12" r="3"/><circle cx="12" cy="7" r="3"/></svg>
      Menu Dishes
    </a>
    <a class="nav-item" href="/admin/reviews">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Reviews
    </a>
    <a class="nav-item" href="/admin/gallery">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      Gallery
    </a>
    <a class="nav-item" href="/admin/hours">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      Opening Hours
    </a>
    <div class="spacer"></div>
    <div class="user">
      <strong><%= admin.display_name %></strong>
      Signed in as admin · <a href="/admin">Refresh</a>
    </div>
    <form class="logout-form" method="post" action="/admin/logout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="logout-btn" type="submit">Sign out</button>
    </form>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <h1>Dashboard</h1>
        <span class="crumb">Overview of the Sutra Lounge website</span>
      </div>
      <div class="actions">
        <a class="btn btn-ghost btn-small" href="/" target="_blank" rel="noopener">View website</a>
      </div>
    </div>

    <% if (!baselineReady) { %>
      <div class="alert alert-error" style="border:1px solid rgba(224,96,79,.4); background:rgba(224,96,79,.12); color:#f2a49a; border-radius:10px; padding:12px 14px; margin-bottom:18px;">
        Baseline content has not been seeded. Run <code>npm run db:seed</code> to populate the site.
      </div>
    <% } %>

    <div class="grid grid-4">
      <div class="stat-card">
        <div class="stat-label">Signature dishes</div>
        <div class="stat-value"><%= counts.signature %></div>
        <div class="stat-hint">live on the menu page</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Bestsellers</div>
        <div class="stat-value"><%= counts.bestsellers %></div>
        <div class="stat-hint">featured on the homepage</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Visible reviews</div>
        <div class="stat-value"><%= counts.reviewsVisible %></div>
        <div class="stat-hint">testimonials section</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Gallery images</div>
        <div class="stat-value"><%= counts.gallery %></div>
        <div class="stat-hint"><%= counts.media %> files in the media library</div>
      </div>
    </div>

    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h3>Site status</h3>
        <ul class="list">
          <li><span class="k">Website</span><span class="v">Live</span></li>
          <li><span class="k">Now in Kathmandu</span><span class="v"><%= opening.label %></span></li>
          <li><span class="k">Today&rsquo;s hours</span><span class="v"><%= opening.hours %></span></li>
          <li>
            <span class="k">Unpublished draft changes</span>
            <% if (draftPending > 0) { %>
              <span class="v"><span class="pill pill-warn"><%= draftPending %> pending</span></span>
            <% } else { %>
              <span class="v"><span class="pill pill-ok">None</span></span>
            <% } %>
          </li>
          <li><span class="k">Media library</span><span class="v"><%= counts.media %> files</span></li>
        </ul>
      </div>
      <div class="card">
        <h3>Quick actions</h3>
        <div class="quick-actions">
          <a class="btn btn-gold btn-small" href="/admin/settings">Edit settings</a>
          <a class="btn btn-ghost btn-small" href="/admin/dishes">Manage dishes</a>
          <a class="btn btn-ghost btn-small" href="/admin/reviews">Manage reviews</a>
          <a class="btn btn-ghost btn-small" href="/admin/gallery">Manage gallery</a>
          <a class="btn btn-ghost btn-small" href="/admin/hours">Edit hours</a>
          <a class="btn btn-ghost btn-small" href="/" target="_blank" rel="noopener">Preview website</a>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:16px;">
      <h3>Recent changes</h3>
      <% if (recentChanges.length === 0) { %>
        <p class="muted">No revisions yet. Changes made in the console appear here.</p>
      <% } else { %>
        <ul class="list">
          <% recentChanges.forEach(function (r) { %>
            <li>
              <span class="k"><%= r.action %> · <%= r.kind %></span>
              <span class="v"><%= r.created_at %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>

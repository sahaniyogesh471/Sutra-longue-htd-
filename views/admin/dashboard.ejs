<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head'); %>
</head>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar'); %>
  <main class="main">
    <%- include('partials/topbar'); %>

    <% if (!baselineReady) { %>
      <div class="alert alert-error">
        Baseline content has not been seeded. Run <code>npm run db:seed</code> to populate the site.
      </div>
    <% } %>

    <div class="grid grid-4">
      <div class="stat-card">
        <div class="stat-label">Signature dishes</div>
        <div class="stat-value"><%= counts.signature %></div>
        <div class="stat-hint">reservation-focused</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Bestsellers</div>
        <div class="stat-value"><%= counts.bestsellers %></div>
        <div class="stat-hint">homepage + menu page</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Visible reviews</div>
        <div class="stat-value"><%= counts.reviewsVisible %></div>
        <div class="stat-hint">testimonials section</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Gallery images</div>
        <div class="stat-value"><%= counts.gallery %></div>
        <div class="stat-hint"><%= counts.media %> files in the media library</div>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card">
        <h3>Site status</h3>
        <ul class="list">
          <li><span class="k">Website</span><span class="v">Live</span></li>
          <li><span class="k">Now in Kathmandu</span><span class="v"><%= opening.label %></span></li>
          <li><span class="k">Today&rsquo;s hours</span><span class="v"><%= opening.hours %></span></li>
          <li>
            <span class="k">Unpublished draft changes</span>
            <% if (draftPending > 0) { %>
              <span class="v"><span class="pill pill-warn"><%= draftPending %> pending</span></span>
            <% } else { %>
              <span class="v"><span class="pill pill-ok">None</span></span>
            <% } %>
          </li>
          <li><span class="k">Media library</span><span class="v"><%= counts.media %> files</span></li>
        </ul>
      </div>
      <div class="card">
        <h3>Quick actions</h3>
        <div class="quick-actions">
          <a class="btn btn-gold btn-small" href="/admin/settings">Edit settings</a>
          <a class="btn btn-ghost btn-small" href="/admin/dishes">Manage dishes</a>
          <a class="btn btn-ghost btn-small" href="/admin/reviews">Manage reviews</a>
          <a class="btn btn-ghost btn-small" href="/admin/gallery">Manage gallery</a>
          <a class="btn btn-ghost btn-small" href="/admin/hours">Edit hours</a>
          <a class="btn btn-ghost btn-small" href="/admin/revisions">Revision history</a>
          <button class="btn btn-ghost btn-small" type="button" data-action="undo">Undo last change</button>
          <button class="btn btn-ghost btn-small" type="button" data-action="redo">Redo</button>
        </div>
      </div>
    </div>

    <div class="card">
      <h3>Recent changes</h3>
      <% if (recentChanges.length === 0) { %>
        <p class="muted">No revisions yet. Published changes appear here and can be undone.</p>
      <% } else { %>
        <ul class="list">
          <% recentChanges.forEach(function (r) { %>
            <li>
              <span class="k"><%= r.action %> · <%= r.kind %><% if (r.created_by) { %> · by <%= r.created_by %><% } %></span>
              <span class="v"><%= r.created_at %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h3>Original version</h3>
      <p class="muted">Make the site exactly as it looks now the protected ORIGINAL. "Reset entire website" will then restore to this version instead of the old demo content. Do this once your real photos and reviews are live.</p>
      <button class="btn btn-gold btn-small" type="button" data-action="save-as-original">Save current site as original</button>
    </div>

    <div class="card card-danger">
      <h3>Danger zone</h3>
      <p class="muted">Reset the entire website back to the protected ORIGINAL baseline content. This cannot be undone automatically.</p>
      <button class="btn btn-danger btn-small" type="button" data-action="reset">Reset entire website</button>
    </div>
  </main>
</div>
<%- include('partials/foot'); %>

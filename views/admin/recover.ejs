<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Recover Account · Sutra Lounge</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/png" sizes="32x32" href="/img/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/img/icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/icon-180.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Playfair+Display:wght@600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Playfair+Display:wght@600;700;800&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Playfair+Display:wght@600;700;800&display=swap"></noscript>
<link rel="stylesheet" href="/admin.css?v=<%= adminAssetsV %>">
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="login-brand">
      <div class="mark">S</div>
      <div>
        <strong>SUTRA</strong>
        <em>ACCOUNT RECOVERY</em>
      </div>
    </div>

    <% if (step === 1) { %>
      <h1>Recover access</h1>
      <p class="sub">Enter your permanent 4-digit recovery code to reset your admin credentials.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/admin/recover">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="step" value="1">
        <div class="field">
          <label for="code">Recovery code</label>
          <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="one-time-code" autofocus required>
        </div>
        <button class="btn btn-gold btn-block" type="submit">Verify code</button>
      </form>
    <% } else { %>
      <h1>Set new credentials</h1>
      <p class="sub">Choose a new username and password to sign in with.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/admin/recover">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="step" value="2">
        <div class="field">
          <label for="username">New username</label>
          <input id="username" name="username" type="text" value="<%= usernameValue %>" autocomplete="username" minlength="3" maxlength="50" autofocus required>
          <% if (fieldErrors && fieldErrors.username) { %><div class="field-error"><%= fieldErrors.username %></div><% } %>
        </div>
        <div class="field">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
          <% if (fieldErrors && fieldErrors.password) { %><div class="field-error"><%= fieldErrors.password %></div><% } %>
        </div>
        <div class="field">
          <label for="confirm">Confirm password</label>
          <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
          <% if (fieldErrors && fieldErrors.confirm) { %><div class="field-error"><%= fieldErrors.confirm %></div><% } %>
        </div>
        <button class="btn btn-gold btn-block" type="submit">Reset credentials</button>
      </form>
    <% } %>

    <p class="login-foot"><a href="/admin/login">Back to sign in</a></p>
  </div>
</div>
</body>
</html>

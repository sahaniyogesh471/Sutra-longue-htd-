<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('partials/head', { title: title, description: description, pageCss: pageCss }); %>
</head>
<body>

  <!-- ============ HEADER ============ -->
  <header class="header is-scrolled">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="<%= s('restaurant.name') %> — back to homepage">
        <span class="brand-mark">S</span>
        <span class="brand-text">
          <strong>SUTRA</strong>
          <em>LOUNGE</em>
        </span>
      </a>

      <div class="header-tools">
        <a class="btn btn-outline-gold menu-call" href="<%= phone.tel %>">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
          <%= phone.display %>
        </a>

        <a class="btn btn-gold menu-home" href="/">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.2 12 4l9 7.2M5.5 10v9h13v-9"/></svg>
          <span>Back to Home</span>
        </a>

        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A8.6 8.6 0 1 1 11.2 3a6.7 6.7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="menu-hero">
      <div class="container">
        <p class="section-kicker"><%= s('restaurant.name') %> · Hupra, <%= s('contact.city') %></p>
        <h1 class="section-title">Full Digital Menu</h1>
        <p class="section-sub">Every signature we are proud of — group platters, wood-fired snacks and lounge drinks. Prices are live and updated from the CMS.</p>
        <div class="menu-hero-actions">
          <a href="<%= whatsapp.href %>?text=<%= encodeURIComponent('Hi Sutra Lounge! Please share your complete menu with prices.') %>" target="_blank" rel="noopener" class="btn btn-gold btn-lg">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Get the Complete Menu on WhatsApp
          </a>
          <a href="/#contact" class="btn btn-outline-gold btn-lg">Reserve a Table</a>
        </div>
        <p class="menu-hero-note">Live prices &middot; Updated from the CMS</p>
      </div>
    </section>

    <!-- ============ MENU ============ -->
    <section class="section menu-page" id="menu">
      <div class="container">
        <% menuGroups.forEach(function (group) { %>
          <div class="menu-cat" id="<%= group.category.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-') %>">
            <div class="menu-cat-head">
              <span class="menu-cat-dot" aria-hidden="true"></span>
              <h2><%= group.category %></h2>
              <span class="menu-cat-line" aria-hidden="true"></span>
            </div>
            <% if (group.sub) { %>
              <p class="menu-cat-sub"><%= group.sub %></p>
            <% } %>

            <div class="dish-grid">
              <% group.dishes.forEach(function (dish) { %>
                <article class="dish-card">
                  <div class="dish-media">
                    <% if (dish.image_url) { %>
                      <img src="<%= dish.image_url %>" alt="<%= dish.name %>" loading="lazy" />
                    <% } %>
                    <% if (dish.badge) { %>
                      <span class="dish-tag"><%= dish.badge %></span>
                    <% } %>
                  </div>
                  <div class="dish-body">
                    <h3><%= dish.name %></h3>
                    <p><%= dish.description %></p>
                    <div class="dish-foot">
                      <% if (dish.price) { %>
                        <span class="dish-price"><%= dish.price %></span>
                      <% } %>
                      <a href="<%= orderLink(dish.name, dish.price || '') %>" target="_blank" rel="noopener" class="dish-link">Order on WhatsApp</a>
                    </div>
                  </div>
                </article>
              <% }); %>
            </div>
          </div>
        <% }); %>

        <p class="menu-note">This is a curated selection of our most-loved dishes. The complete menu spans Nepali, Chinese, Continental and more — ask for it on WhatsApp and we will send it over.</p>
      </div>
    </section>

    <!-- ============ CTA BAND ============ -->
    <section class="menu-cta-band">
      <div class="container">
        <h2 class="section-title">Craving the Complete List?</h2>
        <p class="section-sub">Message us on WhatsApp and we will send the full <%= s('restaurant.name') %> menu with prices, or book a table and taste the favourites in person.</p>
        <div class="menu-cta-actions">
          <a href="<%= whatsapp.href %>?text=<%= encodeURIComponent('Hi Sutra Lounge! Please share your complete menu with prices.') %>" target="_blank" rel="noopener" class="btn btn-gold btn-lg">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Get the Complete Menu on WhatsApp
          </a>
          <a href="/#contact" class="btn btn-outline-gold btn-lg">Reserve a Table</a>
        </div>
      </div>
    </section>

    <!-- ============ VISIT ============ -->
    <section class="section menu-visit">
      <div class="container">
        <p class="section-kicker">Visit Us</p>
        <h2 class="section-title">Find <%= s('restaurant.name') %> in Hupra</h2>
        <div class="menu-visit-grid">
          <div class="menu-visit-item">
            <strong>Address</strong>
            <span><%= address %></span>
          </div>
          <div class="menu-visit-item">
            <strong>Opening Hours</strong>
            <span><%= hoursLabel %></span>
          </div>
          <div class="menu-visit-item">
            <strong>Call to Book</strong>
            <a href="<%= phone.tel %>"><%= phone.display %></a>
          </div>
        </div>
        <div class="menu-hero-actions">
          <a href="<%= mapsUrl %>" target="_blank" rel="noopener" class="btn btn-gold">Get Directions on Google Maps</a>
          <a href="<%= whatsapp.href %>" target="_blank" rel="noopener" class="btn btn-outline-gold">WhatsApp Us</a>
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="container">
      <div class="footer-bottom" style="border-top:1px solid rgba(201,163,92,.12); padding-top:28px;">
        <p>&copy; <span id="year">2026</span> <%= s('restaurant.name') %>. All rights reserved.</p>
        <p><%= meta1 %> &middot; <%= hoursMetaLabel %></p>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      'use strict';
      var stored = null;
      try { stored = localStorage.getItem('sutra-theme'); } catch (e) { /* noop */ }
      document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');

      var toggle = document.getElementById('themeToggle');
      toggle.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('sutra-theme', next); } catch (e) { /* noop */ }
      });

      var year = document.getElementById('year');
      if (year) year.textContent = String(new Date().getFullYear());
    })();
  </script>
</body>
</html>

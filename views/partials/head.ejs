<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<meta name="description" content="<%= description %>" />
<meta name="theme-color" content="#0d0a07" />
<% if (typeof noindex !== 'undefined' && noindex) { %>
<meta name="robots" content="noindex, nofollow" />
<% } else { %>
<meta name="robots" content="index, follow" />
<% } %>
<% if (canonical) { %>
<link rel="canonical" href="<%= canonical %>" />
<% } %>

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="<%= typeof s === 'function' ? s('restaurant.name') : '' %>" />
<meta property="og:title" content="<%= title %>" />
<meta property="og:description" content="<%= description %>" />
<meta property="og:locale" content="en_US" />
<% if (canonical) { %><meta property="og:url" content="<%= canonical %>" /><% } %>
<% var ogImage = (typeof heroSlides !== 'undefined' && heroSlides.length) ? heroSlides[0].image : ''; %>
<% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>" /><% } %>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= title %>" />
<meta name="twitter:description" content="<%= description %>" />
<% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>" /><% } %>

<link rel="icon" type="image/png" sizes="32x32" href="/img/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/img/icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/icon-180.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://images.unsplash.com" crossorigin />
<link rel="dns-prefetch" href="https://images.unsplash.com" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css?v=<%= typeof assetsV !== 'undefined' ? assetsV : 1 %>" />
<%- pageCss || '' %>
<%- typeof brandCss !== 'undefined' && brandCss ? brandCss : '' %>
<noscript>
  <style>.reveal { opacity: 1 !important; transform: none !important; } .preloader { display: none !important; }</style>
</noscript>

<% if (typeof s === 'function' && (typeof noindex === 'undefined' || !noindex)) { %>
<script type="application/ld+json">
<% var phoneDigits = (typeof phone !== 'undefined' && phone && phone.display) ? String(phone.display).replace(/[^\d]/g, '') : ''; %>
<% var waDigits = (typeof whatsapp !== 'undefined' && whatsapp && whatsapp.wa) ? String(whatsapp.wa).replace(/[^\d]/g, '') : (phoneDigits ? '977' + phoneDigits : phoneDigits); %>
<% var addr = (typeof address !== 'undefined') ? address : ''; %>
<% var addrParts = addr.split(',').map(function (p) { return p.trim(); }).filter(Boolean); %>
<% var region = addrParts.length >= 3 ? addrParts[addrParts.length - 2] : ''; %>
<% var socialsList = (typeof socials !== 'undefined' ? socials : {}); %>
<% var sameAs = [socialsList.facebook, socialsList.instagram, socialsList.tiktok, socialsList.youtube].filter(Boolean); %>
<% var gr = (typeof googleReviews !== 'undefined') ? googleReviews : null; %>
<% var ld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: s('restaurant.name'),
  description: s('restaurant.description'),
  servesCuisine: s('restaurant.cuisine'),
  telephone: waDigits ? ('+' + waDigits) : undefined,
  url: canonical || undefined,
  image: ogImage || undefined,
  sameAs: sameAs.length ? sameAs : undefined,
  aggregateRating: gr ? {
    '@type': 'AggregateRating',
    ratingValue: gr.rating,
    reviewCount: gr.count,
    bestRating: '5',
    worstRating: '1'
  } : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: addr,
    addressLocality: s('contact.city') || undefined,
    addressRegion: region || undefined,
    addressCountry: 'Nepal'
  },
  openingHoursSpecification: (typeof hours !== 'undefined' ? hours : []).filter(function (h) { return Number(h.is_open) === 1 && h.open_time && h.close_time; }).map(function (h) {
    return {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.day_name,
      opens: h.open_time,
      closes: h.close_time
    };
  })
};
%><%- JSON.stringify(ld).replace(/</g, '\\u003c') %>
</script>
<% } %>

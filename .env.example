# Sutra Lounge — environment variables
# Copy to .env for local dev; set these as secrets on your host in production.

# --- Runtime ---
NODE_ENV=production
PORT=4173

# --- Database ---
# Two modes:
#
# 1) Managed Turso (libSQL) — REQUIRED on hosts with an ephemeral filesystem
#    (Render, Koyeb, ...) so content survives restarts and redeploys.
#    Get these with:
#      turso db show <db> --url
#      turso db tokens create <db>
TURSO_URL=
TURSO_AUTH_TOKEN=
#
# 2) Local SQLite file — used automatically when TURSO_URL is empty.
#    On a VM/Docker host point this at a persistent volume.
SUTRA_DB_PATH=/app/data/sutra.db

# --- Security (REQUIRED in production) ---
# Long random string. Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-64-char-random-hex-string

# Send the session cookie only over HTTPS. Keep "true" in production.
# Set to "false" only when testing over plain http://localhost.
SESSION_SECURE=true

# --- Initial administrator account ---
# Created on the FIRST server start only. Choose a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Break-glass admin recovery code — must be exactly 4 digits (e.g. 8317).
# It is PERMANENT: set it before the first server start; it cannot be changed
# or recovered afterwards. Store it somewhere safe.
ADMIN_RECOVERY_CODE=

# --- Media storage (Cloudinary) ---
# Required on hosts with an ephemeral filesystem (Render free), otherwise
# images uploaded via the admin panel disappear on the next redeploy.
# Free forever, no credit card: https://cloudinary.com
# Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
